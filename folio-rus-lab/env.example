# Copy this file to .env.folio-rus-lab and replace every placeholder locally.
# Never commit the resulting .env file or paste its values into chat/issues.
FOLIO_RUS_DB_HOST=REPLACE_WITH_VPN_SQL_HOST
FOLIO_RUS_DB_PORT=1433
FOLIO_RUS_DB_USER=REPLACE_WITH_DATABASE_LOGIN
FOLIO_RUS_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
FOLIO_RUS_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional limits
FOLIO_RUS_DB_LOGIN_TIMEOUT_SECONDS=10
FOLIO_RUS_DB_SOCKET_TIMEOUT_SECONDS=90
FOLIO_RUS_LAB_DEFAULT_TIMEOUT_SECONDS=30
FOLIO_RUS_LAB_MAX_TIMEOUT_SECONDS=60
FOLIO_RUS_LAB_DEFAULT_MAX_ROWS=5000
FOLIO_RUS_LAB_MAX_MAX_ROWS=20000
FOLIO_RUS_LAB_DEFAULT_MAX_BYTES=5242880
FOLIO_RUS_LAB_MAX_MAX_BYTES=10485760
